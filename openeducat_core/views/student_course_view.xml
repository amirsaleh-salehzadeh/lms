<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_op_student_course_tree" model="ir.ui.view">
            <field name="name">op.student.course.list</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Doctor Learning Record">
                    <field name="student_id" string="Doctor"/>
                    <field name="course_id"/>
                    <field name="batch_id" string="Learning Cohort"/>
                    <field name="subject_ids" string="Learning Topics" widget="many2many_tags"/>
                    <field name="roll_number" string="Record Number"/>
                    <field name="academic_years_id" string="Training Year" optional="hide"/>
                    <field name="academic_term_id" string="Training Period" optional="hide"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_op_student_course_form" model="ir.ui.view">
            <field name="name">op.student.course.form</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Doctor Learning Record">
                    <header>
                            <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id" string="Doctor"/>
                                <field name="batch_id" string="Learning Cohort" domain="[('course_id', '=', course_id)]" required="1"/>
                                <field name="academic_years_id" string="Training Year"/>
                            </group>
                            <group>
                                <field name="course_id"/>
                                <field name="roll_number" string="Record Number"/>
                                <field name="academic_term_id" string="Training Period"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Learning Topics" name="subjects">
                                <field name="subject_ids" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_student_course_search" model="ir.ui.view">
            <field name="name">op.student.course.search</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Doctor Learning Record">
                    <field name="student_id" string="Doctor"/>
                    <field name="course_id"/>
                    <field name="batch_id" string="Learning Cohort"/>
                    <field name="roll_number" string="Record Number"/>
                    <newline/>
                    <group>
                        <filter string="Course" name="group_by_adm_course_id"
                                domain="[]" context="{'group_by':'course_id'}"/>
                                <filter string="Learning Cohort" name="group_by_adm_batch_id"
                                domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="Training Year" name="group_by_adm_academic_years_id"
                                domain="[]" context="{'group_by':'academic_years_id'}"/>
                        <filter string="Training Period" name="group_by_adm_academic_term_id"
                                domain="[]" context="{'group_by':'academic_term_id'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="view_op_student_course_pivot" model="ir.ui.view">
            <field name="name">op.student.course.pivot</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <pivot string="Doctor Learning Record">
                    <field name="student_id" string="Doctor"/>
                    <field name="course_id" type="row"/>
                    <field name="batch_id" string="Learning Cohort"/>
                </pivot>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_student_course_view">
            <field name="name">Doctor Learning Records</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student.course</field>
            <field name="path">student-course</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="search_view_id" ref="view_op_student_course_search"/>

        </record>
</odoo>
